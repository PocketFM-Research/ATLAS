{"schema_version": "v4", "key": "baseline_100_page__scene_5:relations:5:doc_4_chunk_0_part_0", "value": [{"temp_id": "rel_001", "source_id": "ent_baseline_5_doc_4_chunk_0_part_0_ent_001", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_5_doc_4_chunk_0_part_0_ev_001", "target_type": "Event", "scene_id": "5", "chunk_id": "doc_4_chunk_0_part_0", "evidence": ["\"Because I knew what was in it. I knew what it would do to him... I didn't want to be the person who took the house away from him.\""], "confidence": 0.93, "source_name": "Lucia Serrano", "target_name": "Lucia explains withholding the letter", "id": "rel_baseline_5_doc_4_chunk_0_part_0_rel_001", "movie_id": "baseline_100_page__scene_5"}, {"temp_id": "rel_002", "source_id": "ent_baseline_5_doc_4_chunk_0_part_0_ent_003", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_5_doc_4_chunk_0_part_0_ev_002", "target_type": "Event", "scene_id": "5", "chunk_id": "doc_4_chunk_0_part_0", "evidence": ["\"You didn't take it away from him. Your mother did.\""], "confidence": 0.98, "source_name": "Rosa", "target_name": "Rosa blames mother for taking the house", "id": "rel_baseline_5_doc_4_chunk_0_part_0_rel_002", "movie_id": "baseline_100_page__scene_5"}, {"temp_id": "rel_003", "source_id": "ent_baseline_5_doc_4_chunk_0_part_0_ent_002", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_5_doc_4_chunk_0_part_0_ev_003", "target_type": "Event", "scene_id": "5", "chunk_id": "doc_4_chunk_0_part_0", "evidence": ["\"Ms. Serrano. I am not your priest... I am going to tell you that withholding that letter for six days could have cost your mother's wishes their legal force... Do you understand me.\""], "confidence": 0.9, "source_name": "Asha", "target_name": "Asha confronts Lucia about delay", "id": "rel_baseline_5_doc_4_chunk_0_part_0_rel_003", "movie_id": "baseline_100_page__scene_5"}, {"temp_id": "rel_004", "source_id": "ent_baseline_5_doc_4_chunk_0_par