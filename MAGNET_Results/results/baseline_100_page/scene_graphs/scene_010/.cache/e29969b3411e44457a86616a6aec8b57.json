{"schema_version": "v4", "key": "baseline_100_page__scene_9:relations:9:doc_8_chunk_0_part_1", "value": [{"temp_id": "rel_001", "source_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_001", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_9_doc_8_chunk_0_part_1_ev_001", "target_type": "Event", "scene_id": "9", "chunk_id": "doc_8_chunk_0_part_1", "evidence": ["\"We have until next Wednesday. But the report will not say anything about you. It will say only what the building is worth.\""], "confidence": 0.88, "source_name": "the lawyer", "target_name": "lawyer postpones building decision", "id": "rel_baseline_9_doc_8_chunk_0_part_1_rel_001", "movie_id": "baseline_100_page__scene_9"}, {"temp_id": "rel_002", "source_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_001", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_9_doc_8_chunk_0_part_1_ev_002", "target_type": "Event", "scene_id": "9", "chunk_id": "doc_8_chunk_0_part_1", "evidence": ["\"I would like to suggest that you have at least the first part of that conversation now, while I am here, because I have noticed in other estates that the conversations that begin in front of a lawyer tend to be slightly more careful\""], "confidence": 0.95, "source_name": "the lawyer", "target_name": "lawyer urges careful discussion", "id": "rel_baseline_9_doc_8_chunk_0_part_1_rel_002", "movie_id": "baseline_100_page__scene_9"}, {"temp_id": "rel_003", "source_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_001", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_9_doc_8_chunk_0_part_1_ev_003", "target_type": "Event", "scene_id": "9", "chunk_id": "doc_8_chunk_0_part_1", "evidence": ["\"Mr. Serrano,\" she said. \"Would you start.\""], "confidence": 0.98, "source_name": "the lawyer", "target_name": "lawyer invites Serrano to speak", "id": "rel_baseline_9_doc_8_chunk_0_part_1_rel_003", "movie_id": "baseline_100_page__scene_9"}, {"temp_id": "rel_004", "source_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_002", "source_type": "Character", "relation": "experiences", "target_id": "ev_baseline_9_doc_8_chunk_0_part_1_ev_004", "target_type": "Event", "scene_id": "9", "chunk_id": "doc_8_chunk_0_part_1", "evidence": ["\"He did not look surprised to be asked. He looked, rather, like a man who had been waiting to be asked and who had been rehearsing what he would say\""], "confidence": 0.9, "source_name": "Mr. Serrano", "target_name": "Serrano prepares to speak", "id": "rel_baseline_9_doc_8_chunk_0_part_1_rel_004", "movie_id": "baseline_100_page__scene_9"}, {"temp_id": "rel_005", "source_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_002", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_9_doc_8_chunk_0_part_1_ev_005", "target_type": "Event", "scene_id": "9", "chunk_id": "doc_8_chunk_0_part_1", "evidence": ["\"I have been thinking,\" he said, \"about what I said on Monday. About my mother.\""], "confidence": 0.93, "source_name": "Mr. Serrano", "target_name": "Serrano begins reconsidering his mother's wishes", "id": "rel_baseline_9_doc_8_chunk_0_part_1_rel_005", "movie_id": "baseline_100_page__scene_9"}, {"temp_id": "rel_006", "source_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_002", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_9_doc_8_chunk_0_part_1_ev_006", "target_type": "Event", "scene_id": "9", "chunk_id": "doc_8_chunk_0_part_1", "evidence": ["\"I do not think I know what she would have hated.\""], "confidence": 0.96, "source_name": "Mr. Serrano", "target_name": "Serrano admits uncertainty about mother's feelings", "id": "rel_baseline_9_doc_8_chunk_0_part_1_rel_006", "movie_id": "baseline_100_page__scene_9"}, {"temp_id": "rel_007", "source_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_002", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_9_doc_8_chunk_0_part_1_ev_007", "target_type": "Event", "scene_id": "9", "chunk_id": "doc_8_chunk_0_part_1", "evidence": ["\"I think I know what I would have hated, on her behalf, and I think I have been confusing the two things for a long tim\""], "confidence": 0.97, "source_name": "Mr. Serrano", "target_name": "Serrano distinguishes his feelings from his mother's", "id": "rel_baseline_9_doc_8_chunk_0_part_1_rel_007", "movie_id": "baseline_100_page__scene_9"}, {"temp_id": "rel_016", "source_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_007", "source_type": "Concept", "relation": "is_a", "target_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_007", "target_type": "Concept", "scene_id": "9", "chunk_id": "doc_8_chunk_0_part_1", "evidence": ["\"The conversation about what to do with the building is the conversation you three are going to have\""], "confidence": 0.99, "source_name": "the building decision conversation", "target_name": "the building decision conversation", "id": "rel_baseline_9_doc_8_chunk_0_part_1_rel_016", "movie_id": "baseline_100_page__scene_9"}, {"temp_id": "rel_017", "source_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_008", "source_type": "Concept", "relation": "is_a", "target_id": "ent_baseline_9_doc_8_chunk_0_part_1_ent_008", "target_type": "Concept", "scene_id": "9", "chunk_id": "doc_8_chunk_0_part_1", "evidence": ["\"She looked at the three of them.\""], "confidence": 0.95, "source_name": "the three of them", "target_name": "the three of them", "id": "rel_baseline_9_doc_8_chunk_0_part_1_rel_017", "movie_id": "baseline_100_page__scene_9"}]}