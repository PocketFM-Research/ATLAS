{"schema_version": "v4", "key": "baseline_100_page__scene_10:relations:10:doc_9_chunk_0_part_7", "value": [{"temp_id": "rel_001", "source_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_001", "source_type": "Character", "relation": "experiences", "target_id": "ev_baseline_10_doc_9_chunk_0_part_7_ev_001", "target_type": "Event", "scene_id": "10", "chunk_id": "doc_9_chunk_0_part_7", "evidence": ["\"All right,\" Lucia said.", "It was the silence of a person absorbing something she had half-expected."], "confidence": 0.95, "source_name": "Lucia", "target_name": "Lucia accepts the news calmly", "id": "rel_baseline_10_doc_9_chunk_0_part_7_rel_001", "movie_id": "baseline_100_page__scene_10"}, {"temp_id": "rel_002", "source_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_002", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_10_doc_9_chunk_0_part_7_ev_002", "target_type": "Event", "scene_id": "10", "chunk_id": "doc_9_chunk_0_part_7", "evidence": ["\"I am sorry.\""], "confidence": 0.99, "source_name": "Asha", "target_name": "Asha apologizes", "id": "rel_baseline_10_doc_9_chunk_0_part_7_rel_002", "movie_id": "baseline_100_page__scene_10"}, {"temp_id": "rel_003", "source_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_001", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_10_doc_9_chunk_0_part_7_ev_003", "target_type": "Event", "scene_id": "10", "chunk_id": "doc_9_chunk_0_part_7", "evidence": ["\"Yes. He asked me whether I would consider, if he bought out my share of the house at fair market value, staying in it for a year while he decided what he wanted to do with it.\""], "confidence": 0.96, "source_name": "Lucia", "target_name": "Lucia reveals estate proposal", "id": "rel_baseline_10_doc_9_chunk_0_part_7_rel_003", "movie_id": "baseline_100_page__scene_10"}, {"temp_id": "rel_004", "source_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_001", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_10_doc_9_chunk_0_part_7_ev_004", "target_type": "Event", "scene_id": "10", "chunk_id": "doc_9_chunk_0_part_7", "evidence": ["\"He said he was not asking me to decide today. He said he was telling me he was considering asking me, and he wanted to know whether the question was one I would be willing to receive in two weeks.\""], "confidence": 0.97, "source_name": "Lucia", "target_name": "Lucia postpones answering the proposal", "id": "rel_baseline_10_doc_9_chunk_0_part_7_rel_004", "movie_id": "baseline_100_page__scene_10"}, {"temp_id": "rel_005", "source_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_001", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_10_doc_9_chunk_0_part_7_ev_005", "target_type": "Event", "scene_id": "10", "chunk_id": "doc_9_chunk_0_part_7", "evidence": ["\"I told him I would be willing to receive the question. I told him I had not yet decided what I wanted either, and that I would not pretend to have decided in order to give him an answer, and that if he asked me in two weeks I would tell him what I knew then and not before.\""], "confidence": 0.98, "source_name": "Lucia", "target_name": "Lucia answers the question carefully", "id": "rel_baseline_10_doc_9_chunk_0_part_7_rel_005", "movie_id": "baseline_100_page__scene_10"}, {"temp_id": "rel_006", "source_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_002", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_10_doc_9_chunk_0_part_7_ev_006", "target_type": "Event", "scene_id": "10", "chunk_id": "doc_9_chunk_0_part_7", "evidence": ["\"That was well said.\""], "confidence": 0.99, "source_name": "Asha", "target_name": "Asha praises Lucia's phrasing", "id": "rel_baseline_10_doc_9_chunk_0_part_7_rel_006", "movie_id": "baseline_100_page__scene_10"}, {"temp_id": "rel_007", "source_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_002", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_10_doc_9_chunk_0_part_7_ev_007", "target_type": "Event", "scene_id": "10", "chunk_id": "doc_9_chunk_0_part_7", "evidence": ["\"Is it improper of me to tell you that I am — that I am grateful to you. In an estate sense. As a client. Is that a thing a client is permitted to say.\""], "confidence": 0.98, "source_name": "Asha", "target_name": "Asha expresses estate gratitude", "id": "rel_baseline_10_doc_9_chunk_0_part_7_rel_007", "movie_id": "baseline_100_page__scene_10"}, {"temp_id": "rel_008", "source_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_001", "source_type": "Character", "relation": "performs", "target_id": "ev_baseline_10_doc_9_chunk_0_part_7_ev_008", "target_type": "Event", "scene_id": "10", "chunk_id": "doc_9_chunk_0_part_7", "evidence": ["\"In an estate sense, received and noted.\""], "confidence": 0.99, "source_name": "Lucia", "target_name": "Lucia acknowledges gratitude", "id": "rel_baseline_10_doc_9_chunk_0_part_7_rel_008", "movie_id": "baseline_100_page__scene_10"}, {"temp_id": "rel_009", "source_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_001", "source_type": "Character", "relation": "affinity_with", "target_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_002", "target_type": "Character", "scene_id": "10", "chunk_id": "doc_9_chunk_0_part_7", "evidence": ["\"That was well said.\"", "\"You are welcome to it.\""], "confidence": 0.72, "source_name": "Lucia", "target_name": "Asha", "id": "rel_baseline_10_doc_9_chunk_0_part_7_rel_009", "movie_id": "baseline_100_page__scene_10"}, {"temp_id": "rel_011", "source_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_001", "source_type": "Character", "relation": "possesses", "target_id": "ent_baseline_10_doc_9_chunk_0_part_7_ent_005", "target_type": "Object", "scene_id": "10", "chunk_id": "doc_9_chunk_0_part_7", "evidence": ["\"if he bought out my share of the house at fair market value\""], "confidence": 0.9, "source_name": "Lucia", "target_name": "house", "id": "rel_baseline_10_doc_9_chunk_0_part_7_rel_011", "movie_id": "baseline_100_page__scene_10"}, {"tem