      "id": "ev_syntheti_9_doc_8_chunk_0_ev_001",
      "type": "Event",
      "name": "holt arrives with constables",
      "aliases": [
        "holt arrives with constables"
      ],
      "description": "Holt enters the cartographer's workshop accompanied by two constables, where Felix and Sable are already present.",
      "scene_refs": [
        "9"
      ],
      "evidence": [
        "Holt arrives with two constables. Felix and Sable are already there."
      ]
    },
    {
      "id": "ev_syntheti_9_doc_8_chunk_0_ev_002",
      "type": "Event",
      "name": "holt inspects workshop ceiling",
      "aliases": [
        "holt inspects workshop ceiling"
      ],
      "description": "Holt examines the room and notices the low plastered ceiling, a detail that informs his reassessment of the crime scene.",
      "scene_refs": [
        "9"
      ],
      "evidence": [
        "Holt steps inside and examines the room. He looks up at the low, plastered ceiling -- smooth and close overhead, nothing like the raftered space of a tradesman's hall."
      ]
    },
    {
      "id": "ev_syntheti_9_doc_8_chunk_0_ev_003",
      "type": "Event",
      "name": "holt arrests sable",
      "aliases": [
        "holt arrests sable"
      ],
      "description": "Holt formally places Sable under arrest for suspicion of stealing the Northern Reaches map.",
      "scene_refs": [
        "9"
      ],
      "evidence": [
        "HOLT\nMiss Cross. I am placing you under arrest on suspicion of the theft of the Northern Reaches map."
      ]
    },
    {
      "id": "ev_syntheti_9_doc_8_chunk_0_ev_004",
      "type": "Event",
      "name": "holt cites new evidence",
      "aliases": [
        "holt cites new evidence"
      ],
      "description": "When Sable protests that she was previously cleared, Holt says new evidence has emerged and leaves judgment to the magistrate.",
      "scene_refs": [
        "9"
      ],
      "evidence": [
        "HOLT\nNew evidence has come to light. If you are innocent, the magistrate will say so.",
        "SABLE\nYou cleared me. My alibi -- three witnesses --"
      ]
    },
    {
      "id": "ev_syntheti_9_doc_8_chunk_0_ev_005",
      "type": "Event",
      "name": "felix defends sable",
      "aliases": [
        "felix defends sable"
      ],
      "description": "Felix challenges Holt's reversal and insists that Holt himself had accepted Sable's market alibi.",
      "scene_refs": [
        "9"
      ],
      "evidence": [
        "FELIX\n(stepping forward)\nThis is wrong. You declared her cleared yourself. You said three witnesses placed her at the market all morning."
      ]
    },
    {
      "id": "ev_syntheti_9_doc_8_chunk_0_ev_006",
      "type": "Event",
      "name": "constables seize sable",
      "aliases": [
        "constables seize sable"
      ],
      "description": "After Holt orders Felix back, the constables take Sable by the arms and she submits without resisting.",
      "scene_refs": [
        "9"
      ],
      "evidence": [
        "The constables take Sable by the arms. She does not struggle.",
        "HOLT\nStep back, Mr. Adler."
      ]
    },
    {
      "id": "ev_syntheti_9_doc_8_chunk_0_ev_007",
      "type": "Event",
      "name": "sable shares hollow look",
      "aliases": [
        "sable shares hollow look"
      ],
      "description": "As she is detained, Sable looks at Felix with a hollow expression, underscoring her emotional state and their connection.",
      "scene_refs": [
        "9"
      ],
      "evidence": [
        "She looks at Felix, her expression hollow."
      ]
    },
    {
      "id": "ev_syntheti_9_doc_8_chunk_0_ev_008",
      "type": "Event",
      "name": "holt revises entry theory",
      "aliases": [
        "holt revises entry theory"
      ],
      "description": "Holt announces that he has reconsidered the break-in and now believes the thief entered through the front door rather than the window.",
      "scene_refs": [
        "9"
      ],
      "evidence": [
        "Holt turns and studies the room.",
        "HOLT (CONT'D)\nI have been reconsidering the entry point. The window latch, though worn, shows no sign of recent movement. I now believe the thief entered through the FRONT DOOR. Someone had access."
      ]
    },
    {
      "id": "ev_syntheti_9_doc_8_chunk_0_ev_009",
      "type": "Event",
      "name": "felix produces chest key",
